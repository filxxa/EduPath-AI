# EduPath AI secrets template.
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit the real secrets.toml to version control — it is already in .gitignore.

# Groq API key for the RAG-powered AI advisor.
# Get one at https://console.groq.com/keys — keys start with "gsk_".
# Replace the empty string below with your actual key, e.g.:
#   GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_API_KEY = "your_groq_api_key_here"
